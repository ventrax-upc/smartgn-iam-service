# Replace placeholders in a private copy, then import it into Render Environment.
SPRING_PROFILES_ACTIVE=render
DB_URL=jdbc:postgresql://YOUR_DIRECT_NEON_HOST:5432/smartgn-iam-db?sslmode=require&channelBinding=require
DB_USERNAME=YOUR_IAM_NEON_ROLE
DB_PASSWORD=YOUR_IAM_NEON_PASSWORD
JWT_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_IN_BOTH_SERVICES
DB_POOL_SIZE=5
JWT_EXPIRATION_MINUTES=15
# Empty origins allow same-origin Swagger; add exact frontend origins when available.
ALLOWED_ORIGINS=
# Password reset delivery still requires an external email adapter.
# PASSWORD_RESET_LINK_BASE_URL=https://YOUR_FRONTEND/reset-password
